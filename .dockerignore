# Docker .gitignore equivalent - files to exclude from Docker context
.git
.gitignore
.dockerignore
# OJO con la profundidad: `.env` a secas solo ignora el de la raíz. `COPY backend/ /app/` metía
# `backend/.env` —con DJANGO_SECRET_KEY, la clave JWT y la contraseña de la base— **dentro de la
# imagen**, que es justo lo que se copia al servidor. Los `**/` lo cubren a cualquier nivel.
**/.env
**/.env.local
**/.env.*.local
**/.env.production
*.md
LICENSE
!docker/

# Node modules (will be installed in container) — match at any depth
node_modules/
**/node_modules/
npm-debug.log
yarn-error.log

# Python cache and venv (will be installed in container) — match at any depth.
# Plain "venv/" only matches the context root; backend/venv needs **/venv/.
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/.venv/
venv/
**/venv/

# Game build artifacts not needed in the backend image context
juego/raylib-6.0/
juego/build/
RayLib/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Git
.git
.gitattributes
