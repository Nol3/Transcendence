# Build stage for Angular
FROM node:20-alpine AS builder

WORKDIR /build

# Copy package files from host's front/ directory
COPY front/package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy Angular source code
COPY front/ .

# Build Angular app
RUN npm run build -- --configuration production

# Final stage - serve with Nginx
FROM nginx:alpine

# Remove ALL default nginx content and configs
RUN rm -rf /usr/share/nginx/html/*
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy ALL build output to nginx html root  
# Angular 20 SSR has /browser subfolder, so copy its entire structure to root
COPY --from=builder /build/dist/front/browser/ /usr/share/nginx/html/

# Copy Nginx config
COPY docker/nginx-app.conf /etc/nginx/conf.d/default.conf

EXPOSE 4200

# Start nginx
ENTRYPOINT ["nginx", "-g", "daemon off;"]
