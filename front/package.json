{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve:ssr:front": "node dist/front/server/server.mjs",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "posttest": "node -e \"require('fs').rmSync('dist/test-out',{recursive:true,force:true})\""
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-server": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/service-worker": "^20.3.35",
    "@angular/ssr": "^20.3.42",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.35",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "~3.2.4"
  }
}
