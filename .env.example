# ==========================================
# ENV CONFIGURATION FOR FT_TRANSCENDENCE
# ==========================================

# General
DEBUG=false
ENVIRONMENT=development

# ==========================================
# BACKEND (Django) Configuration
# ==========================================

# Django settings
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,*.transcendence.local

# ── Dominio público (el servidor, con Cloudflare delante) ───────────────────────────────────
# En el servidor estas cuatro van con **tu** dominio. Ejemplo, cambiando `tudominio.com`:
#
#   DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com,localhost,127.0.0.1,backend
#   CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com
#   CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
#   FRONTEND_URL=https://tudominio.com
#
# `CSRF_TRUSTED_ORIGINS` es obligatoria desde Django 4 y el esquema **tiene** que ser `https://`:
# sin ella, el login del admin y cualquier POST desde el dominio dan 403 «CSRF verification
# failed». Se puede dejar vacía en desarrollo.
CSRF_TRUSTED_ORIGINS=

# Database
#
# SQLite (por defecto): cero configuración, datos en backend/db.sqlite3.
DB_ENGINE=django.db.backends.sqlite3
# SQLite usa `SQLITE_PATH` (un fichero) y PostgreSQL usa `DB_NAME` (el nombre de la base).
# Son variables distintas a propósito: con una sola, el `.env` de desarrollo apuntaba
# `DB_NAME` al fichero y producción intentaba conectar a una base llamada `/app/db.sqlite3`.
DB_NAME=transcendence
SQLITE_PATH=db.sqlite3
#
# PostgreSQL: el compose ya levanta el servicio `postgres` (16-alpine) con un volumen
# propio; basta con descomentar estas cinco líneas y `docker compose up -d backend`.
# Ojo: los datos de SQLite NO se migran solos, la base empieza vacía.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=transcendence
# DB_USER=transcendence
# DB_PASSWORD=transcendence
# DB_HOST=postgres
# DB_PORT=5432

# Redis: channel layer y cola de emparejamiento. El compose ya levanta el servicio
# `redis`, así que esto viene puesto por defecto. Para volver a una sola instancia en
# memoria (sin Redis), dejar REDIS_URL vacío.
REDIS_URL=redis://redis:6379/0
MATCH_QUEUE_BACKEND=redis

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Vault. USE_VAULT=true makes the backend read secrets from Vault; set false to
# use the env vars above (e.g. local `manage.py runserver`). The backend
# authenticates via AppRole (creds written by vault-init to the vault_creds
# volume); VAULT_TOKEN is only a manual/dev fallback if AppRole is unavailable.
USE_VAULT=true
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# Email (for password reset, notifications)
# Correo saliente. En desarrollo el backend de consola imprime el mensaje (y el enlace de
# recuperación) en los logs; en producción hay que poner uno de verdad:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# con el host, el usuario y la contraseña del proveedor (Brevo, Resend, SES…).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Transcendence <no-reply@transcendence.local>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# CORS settings
# En el servidor, el dominio (el front se sirve del mismo origen, pero se deja explícito).
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200,http://localhost:3000

# Backend Port
BACKEND_PORT=8000

# ==========================================
# Recuperar la contraseña: a dónde apunta el enlace del correo y cuánto dura (15 min).
# En producción, el dominio público (https://tu-dominio).
# Va en el enlace del correo de «he olvidado mi contraseña»: en el servidor, la URL pública.
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_TIMEOUT=900

# FRONTEND (Angular) Configuration
# ==========================================

# Frontend environment
NG_ENV=development
FRONTEND_PORT=4200
BACKEND_URL=http://localhost:8000
API_URL=http://backend:8000

# ==========================================
# Docker Configuration
# ==========================================

# Compose project name
COMPOSE_PROJECT_NAME=ft_transcendence

# Host ports (all >1024 — no sudo/privileged ports required). Override any that
# clash with other services already running on the machine.
HTTPS_PORT=8443
HTTP_PORT=8080
VAULT_PORT=8200

# Data persistence
DATA_DIR=./docker/volumes
