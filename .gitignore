.env
.DS_Store

# Logs
*.log
logs/

__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

#certificates — never commit private keys / certs (generated at runtime by ssl-init)
ssl/
docker/ssl/
docker/ssl/*.pem
*.pem
*.key
*.crt
# Capturas de revisión visual (front/e2e/capturas.spec.ts)
front/capturas/
