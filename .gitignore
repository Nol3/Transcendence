# Environment variables
.env
.env.local
.env.*.local
.claude

# Node modules (Frontend)
# OJO: la carpeta es `front/`, no `frontend/`. Con la ruta antigua, node_modules,
# dist y .angular quedaban sin ignorar.
front/node_modules/
front/dist/
front/.angular/
front/.vscode/
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.vscode/

# Artefactos de tests del front (se regeneran en cada ejecución de Playwright).
# Los que estaban versionados por error ya se dejaron de seguir
# (`git rm -r --cached front/test-results front/playwright-report`), así que estas
# reglas solo tienen que evitar que vuelvan a entrar.
front/test-results/
front/playwright-report/
front/.playwright/

# Avatares que suben los usuarios: son datos, no código. Se guardan en el volumen
# `media_data` del servidor y en las copias de seguridad, no en el repositorio.
# (Los que ya estaban versionados de antes siguen ahí: sacarlos del historial es una
# decisión aparte, porque entre ellos hay fotos personales en un repositorio público.)
backend/media/avatars/

# Python (Backend)
# Los catálogos compilados son artefactos: se generan con `manage.py compilemessages`
# (lo hace el contenedor al arrancar y el CI antes de los tests). Los .po sí se versionan.
*.mo
backend/.venv/
backend/venv/
backend/__pycache__/
backend/apps/chat/__pycache__/
backend/apps/chat/migrations/__pycache__/
backend/apps/games/__pycache__/
backend/apps/games/migrations/__pycache__/
backend/apps/public_api/__pycache__/
backend/apps/public_api/migrations/__pycache__/
backend/apps/users/__pycache__/
backend/apps/users/migrations/__pycache__/
backend/config/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.egg-info/
backend/dist/
backend/build/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/db.sqlite3
backend/db.sqlite3-journal
# Los otros dos ficheros que crea SQLite al lado de la base de datos (memoria compartida y
# diario de escritura). Estos dos sí estaban versionados por error; se dejan de seguir.
backend/db.sqlite3-shm
backend/db.sqlite3-wal

**/__pycache__/
*.pyc

# Docker
docker/volumes/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

