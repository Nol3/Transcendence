#: apps/users/password_reset.py:51
msgid "Reset your Transcendence password"
msgstr "Réinitialisez votre mot de passe Transcendence"

#: apps/users/password_reset.py:53
#, python-brace-format
msgid ""
"Hi {nombre}:\n"
"\n"
"Someone (we hope you) asked to change the password of your account.\n"
"The link expires in {minutos} minutes and only works once:\n"
"\n"
"{enlace}\n"
"\n"
"If it wasn't you, ignore this email: your password stays the same."
msgstr ""
"Bonjour {nombre} :\n"
"\n"
"Quelqu'un (nous espérons que c'est vous) a demandé à changer le mot de passe de votre compte.\n"
"Le lien expire dans {minutos} minutes et ne fonctionne qu'une seule fois :\n"
"\n"
"{enlace}\n"
"\n"
"Si ce n'était pas vous, ignorez cet e-mail : votre mot de passe ne change pas."

