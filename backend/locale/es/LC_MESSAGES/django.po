#: apps/users/password_reset.py:51
msgid "Reset your Transcendence password"
msgstr "Restablece tu contraseña en Transcendence"

#: apps/users/password_reset.py:53
#, python-brace-format
msgid ""
"Hi {nombre}:\n"
"\n"
"Someone (we hope you) asked to change the password of your account.\n"
"The link expires in {minutos} minutes and only works once:\n"
"\n"
"{enlace}\n"
"\n"
"If it wasn't you, ignore this email: your password stays the same."
msgstr ""
"Hola, {nombre}:\n"
"\n"
"Alguien (esperamos que tú) ha pedido cambiar la contraseña de tu cuenta.\n"
"El enlace caduca en {minutos} minutos y solo sirve una vez:\n"
"\n"
"{enlace}\n"
"\n"
"Si no has sido tú, ignora este correo: tu contraseña sigue como estaba."

