# Entorno de PRODUCCIÓN. En el servidor:
#
#   cp backend/.env.production.example backend/.env
#   # rellena los CAMBIA_ESTO
#
# Y genera las dos claves ahí mismo (nunca las reutilices de desarrollo):
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Este fichero NO se versiona (git ya ignora `.env`). El ejemplo sí.

DJANGO_DEBUG=false
DEBUG=false

# Tu dominio, tal cual, con https:// en las URLs.
# `backend` no es opcional: es el nombre del servicio en la red de Docker, y las peticiones
# que pasan por el nginx del borde llegan con él como Host (los avatares, por ejemplo).
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com,backend
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
PUBLIC_BASE_URL=https://tudominio.com

# Dos claves DISTINTAS, cada una generada en el servidor con el comando de arriba.
DJANGO_SECRET_KEY=CAMBIA_ESTO
JWT_SECRET_KEY=CAMBIA_ESTO

# En producción los secretos viven en este fichero; el Vault del compose va en modo
# desarrollo y no arranca con el overlay de producción.
USE_VAULT=false

# PostgreSQL (el overlay de producción levanta la base de datos).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=transcendence
DB_USER=transcendence
DB_PASSWORD=CAMBIA_ESTO
DB_HOST=postgres
DB_PORT=5432

# Google Sign-In (opcional). El client ID es público; lo que hay que hacer en la
# consola de Google Cloud es añadir https://tudominio.com como origen y redirect URI.
GOOGLE_CLIENT_ID=

# Correo, para que funcione «he olvidado mi contraseña». Con Gmail hace falta una
# «contraseña de aplicación» (no la del correo).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# HSTS: cuánto tiempo le dice el navegador a sus visitantes que solo hablen HTTPS.
# En un dominio recién comprado conviene empezar corto (300 = cinco minutos) hasta
# comprobar que todo —incluido el WebSocket— va por HTTPS. Cuando esté seguro,
# 31536000 (un año) es lo normal.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
